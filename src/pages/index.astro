---
import Base from '../layouts/Base.astro';
import SunMark from '../components/SunMark.astro';
import Arrow from '../components/Arrow.astro';
import SolarEngine from '../components/SolarEngine.astro';
const appUrl = 'https://bryannamd.github.io/hanja-web/';
const capabilities = [
  {
    title: 'AI-native.',
    subtitle: 'AI와 함께, 더 빠르게.',
    body: '아이디어를 탐색하고, 코드를 만들고, 직접 검증합니다. AI와 함께 빠르게 시도하고, 제품에 필요한 답을 찾아갑니다.',
    tags: ['AI-assisted development', 'Rapid prototyping'],
    key: 'ai',
  },
  {
    title: 'Engineered.',
    subtitle: '보이는 화면 너머까지.',
    body: '앱과 웹, 데이터와 API. 각각의 기술을 하나의 경험으로 연결합니다. 작은 시작에서 다음 확장까지 생각하며 설계합니다.',
    tags: ['App & web', 'API architecture'],
    key: 'engineering',
  },
  {
    title: 'Human, always.',
    subtitle: '마지막 기준은, 사람.',
    body: '기술의 복잡함은 안쪽에. 쓰는 순간의 명료함은 바깥에. 화면 한 장부터 작은 움직임까지, 손에 닿는 경험을 다듬습니다.',
    tags: ['Product design', 'Creative interaction'],
    key: 'design',
  },
];
---

<Base>
  <div class="header-shell" id="top">
    <header class="site-header wrap">
      <a class="wordmark" href="#top" aria-label="sunworks 처음으로">
        <SunMark />
        sunworks
      </a>
      <nav aria-label="주요 메뉴">
        <a href="#technology">기술과 관점</a>
        <a href="#work">만드는 것</a>
      </nav>
      <a class="header-link" href="#work">
        Explore our work <Arrow diagonal />
      </a>
    </header>
  </div>
  <main id="main">
    <div class="opening">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-heading">
          <h1 id="hero-title" lang="en">
            <span>Ideas.</span>
            <span>
              Made real<span class="hero-period">.</span>
            </span>
          </h1>
          <p class="hero-statement">상상을, 작동하는 현실로.</p>
        </div>
        <SolarEngine />
        <div class="hero-bottom">
          <p class="hero-intro">
            AI의 가능성에 엔지니어링과 디자인을 더해,
            <br class="desktop-break" /> 새로운 앱과 웹서비스를 만듭니다.
          </p>
          <a class="round-link hero-link" href="#technology">
            <span>What makes us work</span>
            <span class="round-arrow">
              <Arrow />
            </span>
          </a>
        </div>
      </section>
    </div>

    <div class="discipline-strip" aria-label="AI, 엔지니어링, 제품 디자인">
      <div class="wrap discipline-inner">
        <span>AI-driven thinking</span>
        <SunMark />
        <span>Creative engineering</span>
        <SunMark />
        <span>Products with purpose</span>
        <SunMark />
      </div>
    </div>

    <section class="manifesto wrap" aria-labelledby="manifesto-title">
      <div class="manifesto-body">
        <h2 id="manifesto-title">
          “이런 게 있다면?”을
          <br />
          “이제 쓸 수 있어.”로<span class="ink-dot">.</span>
        </h2>
        <div class="manifesto-copy">
          <p>
            우리는 기술을 탐구하고,
            <br />
            가능성을 직접 만드는 제품 회사입니다.
          </p>
          <p>
            새로운 AI 기술, 단단한 소프트웨어, 감각적인 디자인.
            <br class="desktop-break" /> 서로 다른 영역이 만날 때, 이전에 없던
            경험이 시작됩니다.
          </p>
        </div>
      </div>
    </section>

    <section
      id="technology"
      class="technology-section"
      aria-labelledby="technology-title"
    >
      <div class="wrap">
        <div class="section-heading technology-heading">
          <h2 id="technology-title" lang="en">
            Curiosity meets
            <br />
            <span>capability.</span>
          </h2>
          <p>
            상상은 대담하게.
            <br />
            만드는 과정은 치밀하게.
          </p>
        </div>
        <div class="capability-layout">
          <div class="capability-list">
            {capabilities.map((item, i) => (
              <details
                class="capability"
                name="capabilities"
                open={i === 0}
                data-capability={item.key}
              >
                <summary>
                  <span lang="en">{item.title}</span>
                  <span class="detail-toggle" aria-hidden="true"></span>
                </summary>
                <div class="capability-content">
                  <h3>{item.subtitle}</h3>
                  <p>{item.body}</p>
                  <ul aria-label="관련 분야">
                    {item.tags.map((tag) => (
                      <li lang="en">{tag}</li>
                    ))}
                  </ul>
                </div>
              </details>
            ))}
          </div>
          <div class="workbench" data-workbench="ai" aria-hidden="true">
            <div class="workbench-top">
              <span>Inside the process</span>
              <span class="workbench-indicator"></span>
            </div>
            <div class="process-visual process-ai">
              <div class="idea-input">
                <span>What if...</span>
                <span class="input-cursor"></span>
              </div>
              <div class="flow-line"></div>
              <div class="ai-core">
                <SunMark />
                <span>Human × AI</span>
              </div>
              <div class="flow-line"></div>
              <div class="output-pieces">
                <span>탐색</span>
                <span>구현</span>
                <span>검증</span>
              </div>
            </div>
            <div class="process-visual process-engineering">
              <div class="system-top">
                <span>App</span>
                <span>Web</span>
              </div>
              <div class="system-connect"></div>
              <div class="api-node">
                <span>API</span>
                <span>One connected experience</span>
              </div>
              <div class="system-connect"></div>
              <div class="system-top">
                <span>Data</span>
                <span>AI</span>
              </div>
            </div>
            <div class="process-visual process-design">
              <div class="design-target">
                <span></span>
                <span></span>
                <span></span>
                <SunMark />
              </div>
              <div class="design-feedback">
                <span>Feels right.</span>
                <Arrow diagonal />
              </div>
            </div>
            <div class="workbench-bottom">
              <span data-process-caption>
                질문에서 작동하는 프로토타입까지.
              </span>
              <span>
                sunworks <Arrow diagonal />
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="work" class="work-section wrap" aria-labelledby="work-title">
      <div class="section-heading work-heading">
        <h2 id="work-title" lang="en">
          Less talk.
          <br />
          More{' '}
          <span class="work-making">
            making
            <svg
              viewBox="0 0 420 24"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path d="M3 18Q204-5 417 9" />
            </svg>
          </span>
          .
        </h2>
        <p>
          아이디어가 제품이 되는 곳.
          <br />
          지금, 우리가 만들고 있는 첫 번째 경험.
        </p>
      </div>
      <article class="product-feature" aria-labelledby="product-title">
        <div class="product-copy">
          <h3 id="product-title">
            <img
              src="/assets/hanja-icon.webp"
              alt=""
              width="44"
              height="44"
              loading="lazy"
            />
            어흥!한자
          </h3>
          <p class="product-lead">
            어려운 한자에,
            <br />
            즐거운 반전.
          </p>
          <p class="product-description">
            캐릭터와 함께 익히고, 기억에 맞춰 다시 만나고.
            <br class="desktop-break" /> 배움이 계속되는 경험을 만드는 한자 학습
            앱.
          </p>
          <ul class="product-tags" aria-label="제품 특징">
            <li>캐릭터 학습</li>
            <li>간격 반복</li>
            <li>앱 & 웹</li>
          </ul>
          <a
            class="button button-dark"
            href={appUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            웹에서 먼저 만나기 <Arrow diagonal />
            <span class="sr-only">(새 창)</span>
          </a>
          <p class="product-status">
            <span></span>정식 출시 준비 중 · 웹 베타 공개
          </p>
        </div>
        <div class="product-art">
          <span class="hanja-graphic" aria-hidden="true">
            好
          </span>
          <div class="hanja-chip chip-one" aria-hidden="true">
            <span>日</span>
            <span>해 일</span>
          </div>
          <img
            class="horang"
            src="/assets/horang.webp"
            width="500"
            height="500"
            alt="붓과 두루마리를 든 어흥!한자의 호랑이 캐릭터"
            loading="lazy"
          />
          <div class="hanja-chip chip-two" aria-hidden="true">
            <span>學</span>
            <span>배울 학</span>
          </div>
          <span class="product-art-caption" lang="en">
            A new way to say “I get it.”
          </span>
        </div>
      </article>
      <p class="work-footnote">
        배움은 첫 번째 시작. sunworks의 다음 가능성은 더 넓은 일상으로
        이어집니다.
      </p>
    </section>

    <section class="closing-section" aria-labelledby="closing-title">
      <div class="wrap">
        <div class="closing-top">
          <h2 id="closing-title">
            다음은,
            <br />
            어떤 가능성일까요?
          </h2>
          <a
            class="round-link"
            href={appUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>
              우리의 첫 제품 만나기<span class="sr-only">(새 창)</span>
            </span>
            <span class="round-arrow">
              <Arrow diagonal />
            </span>
          </a>
        </div>
        <div class="closing-brand" aria-hidden="true">
          <span>sunworks</span>
          <SunMark />
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer wrap">
    <p>Independent minds. Real things.</p>
    <a href="#top">
      Back to top <Arrow diagonal />
    </a>
    <span>© {new Date().getFullYear()} sunworks</span>
  </footer>
  <script>
    const workbench = document.querySelector<HTMLElement>('[data-workbench]');
    const caption = document.querySelector<HTMLElement>(
      '[data-process-caption]',
    );
    const captions: Record<string, string> = {
      ai: '질문에서 작동하는 프로토타입까지.',
      engineering: '제품에 맞춰 연결하는 구조.',
      design: '한 번의 터치에도, 분명한 이유.',
    };
    document
      .querySelectorAll<HTMLDetailsElement>('[data-capability]')
      .forEach((detail) => {
        detail.addEventListener('toggle', () => {
          if (detail.open && workbench) {
            const key = detail.dataset.capability ?? 'ai';
            workbench.dataset.workbench = key;
            if (caption) caption.textContent = captions[key];
          }
        });
      });
  </script>
</Base>
