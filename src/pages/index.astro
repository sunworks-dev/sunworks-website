---
import Base from '../layouts/Base.astro';
import BrandLogo from '../components/BrandLogo.astro';
import Arrow from '../components/Arrow.astro';
import IdeaPress from '../components/IdeaPress.astro';
const appUrl = 'https://bryannamd.github.io/hanja-web/';
const practices = [
  {
    title: '아이디어는 빨리 눈앞에.',
    body: '머릿속에서만 완벽한 아이디어보다, 직접 눌러볼 수 있는 작은 시작을 좋아합니다. AI로 탐색과 구현의 속도를 높이고, 무엇을 남길지는 직접 써보며 판단합니다.',
    note: '빠른 실험 · 프로토타이핑 · AI 활용',
  },
  {
    title: '화면 뒤도, 제대로.',
    body: '버튼을 누른 다음의 일도 설계합니다. 앱과 웹, 데이터와 API가 자연스럽게 이어지도록. 눈에 보이는 즐거움을, 보이지 않는 코드가 든든하게 받칩니다.',
    note: '앱과 웹 · 데이터 · API 설계',
  },
  {
    title: '한 번 더 만져보게.',
    body: '설명 없이도 알겠는 버튼, 손가락이 편한 간격, 기다림이 덜 지루한 순간. 작은 차이를 그냥 넘기지 않습니다. 사람이 쓰는 것이니까요.',
    note: '인터랙션 · 접근성 · 반응형 디자인',
  },
];
---

<Base>
  <header class="masthead" id="top">
    <div class="wrap masthead-inner">
      <a class="brand-link" href="#top" aria-label="썬웍스, 처음으로">
        <BrandLogo />
      </a>
      <nav aria-label="주요 메뉴">
        <a href="#about">우리의 생각</a>
        <a href="#work">만든 것</a>
        <a href="#play">
          딴생각 인쇄소 <Arrow diagonal />
        </a>
      </nav>
    </div>
  </header>
  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">
          <span>쓸모 있는</span>
          <span class="hero-punch">딴생각.</span>
        </h1>
        <div class="hero-intro">
          <p class="hero-hook">
            그냥 지나치기엔,
            <br />꽤 괜찮은 생각이니까.
          </p>
          <p>
            썬웍스는 일상의 작은 발견을
            <br />
            직접 쓰고 싶은 앱과 웹서비스로 만듭니다.
          </p>
          <a class="button button-ink" href="#work">
            만든 것부터 볼까요? <Arrow diagonal />
          </a>
        </div>
      </div>
      <figure class="hero-art">
        <img
          src="/assets/making-sun.webp"
          width="1254"
          height="1254"
          alt="연필을 쥔 손이 노란 해를 그려내는 빈티지 인쇄풍 일러스트"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>
          연필 끝에서 시작해,
          <br />
          손끝에 닿기까지.
        </figcaption>
      </figure>
      <div class="hero-colophon" aria-hidden="true">
        <span>SMALL IDEAS. REAL THINGS.</span>
        <span>조금 다르게, 끝까지.</span>
      </div>
    </section>
    <div class="sun-strip" aria-hidden="true">
      <div class="sun-strip-inner">
        <span>GOOD IDEAS DESERVE TO EXIST.</span>
        <Arrow diagonal />
        <span>재밌는 건, 만들어 봐야지.</span>
      </div>
    </div>
    <section id="about" class="about wrap" aria-labelledby="about-title">
      <h2 id="about-title">
        불편함엔 참견을.
        <br />
        좋은 생각엔 고집을.
      </h2>
      <div class="about-copy">
        <p class="about-lead">
          “이런 게 있으면 좋겠다.”
          <br />
          우리에게는, 꽤 진지한 시작입니다.
        </p>
        <p>
          써보니 어딘가 번거로운 순간. 배우다 문득 재미없어진 순간. 그냥 넘길
          수도 있지만, 우리는 거기서 자꾸 딴생각을 합니다.
        </p>
        <p>
          작게 만들고, 직접 써보고, 다시 고칩니다. 그렇게 나에게도, 누군가에게도
          쓸모 있는 것을 하나씩 세상에 내놓습니다.
        </p>
      </div>
    </section>
    <section id="work" class="work" aria-labelledby="work-title">
      <div class="wrap">
        <div class="work-heading">
          <h2 id="work-title">
            생각만 하진
            <br />
            않았습니다.
          </h2>
          <p>
            지금 만들고 있는 것.
            <br />
            가장 먼저 건네는 썬웍스의 제품입니다.
          </p>
        </div>
        <article class="product" aria-labelledby="product-title">
          <div class="product-scene">
            <div class="product-sun" aria-hidden="true"></div>
            <span class="product-character" aria-hidden="true">
              好
            </span>
            <img
              class="horang"
              src="/assets/horang.webp"
              width="500"
              height="500"
              alt="붓과 두루마리를 든 어흥!한자의 호랑이 캐릭터"
              loading="lazy"
            />
            <p class="product-scene-note">“아하!”가 “어흥!”이 되는 순간.</p>
          </div>
          <div class="product-copy">
            <h3 id="product-title">
              <img
                src="/assets/hanja-icon.webp"
                alt=""
                width="48"
                height="48"
                loading="lazy"
              />
              어흥!한자
            </h3>
            <p class="product-tagline">
              외우는 얼굴 말고,
              <br />
              알아가는 표정.
            </p>
            <p class="product-description">
              낯선 한자를 캐릭터와 함께 만나고,
              <br class="wide-break" /> 잊을 때쯤 한 번 더. ‘공부해야지’보다
              <br class="wide-break" /> ‘조금 더 해볼까’가 먼저인 배움을
              만듭니다.
            </p>
            <ul class="product-features" aria-label="제품 특징">
              <li>캐릭터와 익히는 한자</li>
              <li>기억에 맞춘 반복 학습</li>
            </ul>
            <a
              class="button button-ink"
              href={appUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              웹에서 먼저 만나기 <Arrow diagonal />
              <span class="sr-only">(새 창)</span>
            </a>
            <p class="product-status">정식 출시 준비 중 · 웹 베타 공개</p>
          </div>
        </article>
        <p class="work-note">첫 번째는 배움. 다음 딴생각은, 일상 어디에서든.</p>
      </div>
    </section>
    <section class="making wrap" aria-labelledby="making-title">
      <div class="making-heading">
        <h2 id="making-title">
          만드는 손은 가볍게.
          <br />
          만드는 기준은 단단하게.
        </h2>
        <p>재미있는 생각이, 좋은 제품으로 남도록.</p>
      </div>
      <div class="making-body">
        <p class="making-type" lang="en" aria-hidden="true">
          A LITTLE
          <br />
          <span>HUNCH.</span>
          <br />A LOT OF
          <br />
          <span>CRAFT.</span>
        </p>
        <div class="practices">
          {practices.map((practice, i) => (
            <details class="practice" name="making" open={i === 0}>
              <summary>
                <span>{practice.title}</span>
                <span class="detail-toggle" aria-hidden="true"></span>
              </summary>
              <div class="practice-content">
                <p>{practice.body}</p>
                <p class="practice-note">{practice.note}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
    <IdeaPress />
    <section class="closing" aria-labelledby="closing-title">
      <div class="wrap closing-inner">
        <h2 id="closing-title">
          좋아하는 것을,
          <br />
          쓸모 있는 것으로.
        </h2>
        <div class="closing-copy">
          <p>다음 딴생각도, 썬웍스답게.</p>
          <a class="text-link" href="#work">
            우리의 첫 시작 만나보기 <Arrow diagonal />
          </a>
        </div>
      </div>
    </section>
  </main>
  <footer class="footer">
    <div class="wrap">
      <a class="footer-brand" href="#top" aria-label="썬웍스, 맨 위로">
        <BrandLogo />
      </a>
      <div class="footer-bottom">
        <p>생각은 자유롭게. 만드는 일은 진심으로.</p>
        <span>© {new Date().getFullYear()} sunworks</span>
        <a href="#top">
          맨 위로 <Arrow diagonal />
        </a>
      </div>
    </div>
  </footer>
</Base>
