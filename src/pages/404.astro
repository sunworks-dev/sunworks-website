---
import Base from '../layouts/Base.astro';
import BrandLogo from '../components/BrandLogo.astro';
import Arrow from '../components/Arrow.astro';
---

<Base
  title="페이지를 찾을 수 없어요 — SunWorks"
  description="SunWorks 첫 화면으로 돌아가세요."
>
  <main id="main" class="not-found wrap">
    <a class="brand-link" href="/" aria-label="썬웍스, 처음으로">
      <BrandLogo />
    </a>
    <h1>
      길을 조금
      <br />
      벗어났네요.
    </h1>
    <p>
      이 주소에는 페이지가 없어요.
      <br />첫 화면에서 다시 둘러보세요.
    </p>
    <p lang="en">
      This page doesn’t exist.{' '}
      <a class="text-link" href="/en/" hreflang="en">
        Go to the English home <Arrow diagonal />
      </a>
    </p>
    <a class="button button-ink" href="/">
      첫 화면으로 돌아가기 <Arrow diagonal />
    </a>
  </main>
</Base>
