---
const states = [
  { name: 'Imagine', description: '가능성은 하나의 질문에서 시작됩니다.' },
  { name: 'Build', description: '흩어진 아이디어에 작동하는 구조를 만듭니다.' },
  { name: 'Launch', description: '직접 쓰는 제품으로 세상과 연결합니다.' },
];
---

<div class="solar-experience" data-solar-experience>
  <div class="solar-viewport" data-solar-viewport>
    <div class="solar-fallback" aria-hidden="true">
      <img
        src="/assets/solar-engine.webp"
        width="800"
        height="700"
        alt=""
        fetchpriority="high"
      />
    </div>
    <canvas class="solar-canvas" aria-hidden="true"></canvas>
    <p class="engine-note">
      <span aria-hidden="true"></span> 제품 제작 과정을 담은 인터랙티브 실험
    </p>
  </div>
  <div class="engine-console" hidden data-engine-console>
    <div
      class="engine-controls"
      role="group"
      aria-label="3D로 보는 제품 제작 과정"
    >
      {states.map((state, i) => (
        <button
          type="button"
          data-engine-state={i}
          aria-pressed={i === 0}
          aria-describedby="engine-description"
        >
          <span class="control-dot" aria-hidden="true"></span>
          {state.name}
        </button>
      ))}
    </div>
    <p id="engine-description" aria-live="polite">
      {states[0].description}
    </p>
  </div>
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-solar-experience]');
  if (root) {
    import('../scripts/solar-engine')
      .then(({ mountSolarEngine }) => mountSolarEngine(root))
      .catch(() => {
        root.dataset.render = 'fallback';
      });
  }
</script>
