---
import Arrow from './Arrow.astro';
import Lines from './Lines.astro';
import type { Copy, Lang } from '../i18n';

interface Props {
  copy: Copy['press'];
  lang: Lang;
}
const { copy, lang } = Astro.props;
---

<section
  id="play"
  class="idea-press"
  aria-labelledby="press-title"
  data-idea-press
  data-lang={lang}
  data-ideas={JSON.stringify(copy.ideas)}
  data-saving={copy.saving}
  data-saved={copy.saved}
  data-failed={copy.failed}
  data-card-top={copy.cardTop}
  data-card-bottom={copy.cardBottom}
>
  <div class="wrap press-layout">
    <div class="press-copy" data-scroll-scene="heading">
      <h2 id="press-title">
        <Lines lines={copy.title.slice(0, -1)} /> <br />
        <span>{copy.title.at(-1)}</span>
      </h2>
      <p>
        <Lines lines={copy.intro} />
      </p>
      <p class="press-invitation">
        <Lines lines={copy.invitation} />
      </p>
    </div>
    <div class="press-workspace" data-scroll-scene="press">
      <div class="press-trim" aria-hidden="true">
        <span>{copy.trim[0]}</span>
        <span>{copy.trim[1]}</span>
      </div>
      <div class="print-deck" data-print-deck>
        <div
          class="print-sheet"
          data-print-sheet
          role="group"
          aria-labelledby="print-card-title"
        >
          <div class="print-top">
            <span id="print-card-title">{copy.cardTop}</span>
            <span data-print-count>1 / {copy.ideas.length}</span>
          </div>
          <p
            class="print-question"
            data-print-question
            aria-live="polite"
            aria-atomic="true"
          >
            <Lines lines={copy.ideas[0]} />
          </p>
          <div class="print-sun" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="print-bottom">
            <span>{copy.cardBottom}</span>
            <span>sunworks.kr</span>
          </div>
        </div>
      </div>
      <div class="print-pagination" data-print-pagination hidden>
        {copy.ideas.map((idea, index) => (
          <button
            type="button"
            data-print-index={index}
            aria-label={idea.join(' ')}
            aria-pressed={index === 0}
          >
            <span aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <div class="press-controls" data-print-controls hidden>
        <button class="button button-paper" type="button" data-print-next>
          {copy.next} <Arrow />
        </button>
        <button class="save-button" type="button" data-print-save>
          {copy.save}{' '}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" />
          </svg>
        </button>
      </div>
      <p class="press-status" data-print-status role="status"></p>
    </div>
  </div>
</section>
<script>
  import '../scripts/idea-press';
</script>
