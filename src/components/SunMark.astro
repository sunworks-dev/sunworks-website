---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class:list={['sun-mark', className]}
  viewBox="0 0 48 48"
  fill="currentColor"
  aria-hidden="true"
>
  {Array.from({ length: 8 }, (_, i) => (
    <rect
      x="21"
      y="1"
      width="6"
      height="16"
      rx="1"
      transform={`rotate(${i * 45} 24 24)`}
    />
  ))}
  <circle cx="24" cy="24" r="5" />
</svg>
