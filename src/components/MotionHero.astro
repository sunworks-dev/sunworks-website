---
import Arrow from './Arrow.astro';
import Lines from './Lines.astro';
import { copy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].hero;
const root = `/assets/motion/daylight-${lang}`;
---

<section class="motion-hero" aria-labelledby="hero-title" data-motion-hero>
  <h1 id="hero-title" class="sr-only">
    {t.title.join(' ')}
  </h1>
  <p id="film-description" class="sr-only">
    {t.motion.description}
  </p>
  <div class="motion-stage">
    <picture class="motion-poster">
      <source
        media="(max-width: 760px)"
        srcset={`${root}-mobile.webp`}
        width="1080"
        height="1440"
      />
      <img
        src={`${root}-desktop.webp`}
        width="1920"
        height="960"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <video
      id="brand-film"
      class="motion-video"
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      aria-hidden="true"
      data-root={root}
    ></video>
    <button
      class="motion-control"
      type="button"
      aria-controls="brand-film"
      aria-describedby="film-description"
      data-play={t.motion.play}
      data-pause={t.motion.pause}
      data-replay={t.motion.replay}
      data-failed={t.motion.failed}
      hidden
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path class="motion-play-icon" d="M9 6.5v11l9-5.5Z"></path>
        <path class="motion-pause-icon" d="M9.5 7v10M14.5 7v10"></path>
      </svg>
      <span class="sr-only" data-control-label>
        {t.motion.play}
      </span>
    </button>
  </div>
  <div class="motion-intro wrap">
    <p class="motion-hook">
      <Lines lines={t.hook} />
    </p>
    <p class="motion-summary">
      <Lines lines={t.intro} />
    </p>
    <a class="button button-ink" href="#work">
      {t.cta}
      <Arrow diagonal />
    </a>
  </div>
  <p class="sr-only" role="status" data-motion-status></p>
</section>

<script>
  import '../scripts/hero-film';
</script>

<style>
  .motion-hero {
    background: var(--paper);
  }
  .motion-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: var(--paper);
  }
  .motion-poster,
  .motion-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .motion-poster img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .motion-video {
    object-fit: contain;
    background: var(--black);
    visibility: hidden;
  }
  [data-frame-visible] .motion-video {
    visibility: visible;
  }
  [data-frame-visible] .motion-poster {
    visibility: hidden;
  }
  /* 글자는 보조기기용으로 숨기고, 화면에는 흰 선 아이콘만 둔다.
     영상 구석이 종이색일 때도 대비 3:1을 지키도록 반투명 잉크 바탕을 깐다. */
  .motion-control {
    position: absolute;
    right: clamp(16px, 3.8vw, 56px);
    bottom: clamp(36px, 4vw, 62px);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1.5px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    color: #fff;
    background: rgba(36, 33, 29, 0.6);
    z-index: 1;
    transition:
      background-color 180ms var(--ease),
      scale 180ms var(--ease);
  }
  .motion-control:active {
    scale: 0.94;
  }
  @media (prefers-reduced-motion: reduce) {
    .motion-control:active {
      scale: 1;
    }
  }
  .motion-control[hidden] {
    display: none;
  }
  .motion-control svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .motion-pause-icon {
    display: none;
  }
  [data-playing] .motion-pause-icon {
    display: block;
  }
  [data-playing] .motion-play-icon {
    display: none;
  }
  .motion-control:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 4px;
  }
  .motion-intro {
    display: grid;
    grid-template-columns: 1.1fr 1fr auto;
    gap: 36px;
    align-items: center;
    padding-block: 34px 38px;
  }
  .motion-hook {
    font-size: clamp(18px, 1.5vw, 22px);
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: -0.015em;
  }
  .motion-summary {
    max-width: 42ch;
    font-size: 15px;
    line-height: 1.8;
  }
  .motion-intro .button {
    gap: 20px;
  }
  @media (hover: hover) {
    .motion-control:hover {
      background: rgba(36, 33, 29, 0.82);
    }
  }
  @media (max-width: 1100px) {
    .motion-intro {
      grid-template-columns: 1fr 1fr;
      gap: 20px 32px;
    }
    .motion-intro .button {
      justify-self: start;
    }
  }
  @media (max-width: 760px) {
    .motion-stage {
      aspect-ratio: 3 / 4;
    }
    .motion-control {
      bottom: 34px;
      right: 16px;
    }
    .motion-intro {
      grid-template-columns: 1fr;
      gap: 18px;
      padding-block: 28px 34px;
    }
    .motion-hook {
      font-size: 20px;
    }
    .motion-summary {
      font-size: 15px;
    }
    .motion-intro .button {
      margin-top: 4px;
    }
  }
</style>
