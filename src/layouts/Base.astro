---
import '@fontsource/gasoek-one';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/noto-sans-kr';
import '../styles/global.css';
import { company, copy, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogLocale?: string;
  alternates?: { hreflang: string; href: string }[];
  noindex?: boolean;
}
const { lang = 'ko', alternates = [], noindex = false } = Astro.props;
const meta = copy[lang].meta;
const {
  title = meta.title,
  description = meta.description,
  ogImage = meta.ogImage,
  ogImageAlt = meta.ogImageAlt,
  ogLocale = meta.ogLocale,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// 검색엔진·AI가 읽는 회사 정보. 화면의 회사 정보와 같은 값만 쓰고, 그 정보가 보이는 홈에만 넣는다.
const info = copy[lang].company;
const orgId = new URL('/#organization', Astro.site);
const jsonLd =
  Astro.url.pathname === copy[lang].path &&
  JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': orgId,
        name: 'SunWorks',
        // 한글 사업자등록증 상호와 영문 사업자등록증명 상호.
        legalName: copy.ko.company.name,
        alternateName: copy.en.company.name,
        url: Astro.site,
        logo: new URL('/assets/sunworks-korean-logo.png', Astro.site),
        email: company.email,
        telephone: company.tel,
        foundingDate: company.founded,
        taxID: company.bizNo,
        address: {
          '@type': 'PostalAddress',
          streetAddress: info.address.join(' '),
          addressCountry: 'KR',
        },
        sameAs: ['https://github.com/sunworks-dev'],
      },
      {
        '@type': 'WebSite',
        '@id': new URL('/#website', Astro.site),
        name: 'SunWorks',
        alternateName: '썬웍스',
        url: Astro.site,
        inLanguage: ['ko', 'en'],
        publisher: { '@id': orgId },
      },
    ],
  }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#24211d" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    {alternates.map(({ hreflang, href }) => (
      <link
        rel="alternate"
        hreflang={hreflang}
        href={new URL(href, Astro.site)}
      />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="SunWorks" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <!-- 기기 스토어만 보이기: 어흥!한자 앱 설정 화면이 이 사이트를 연다. iOS 앱 안에서 Google Play가, Android 앱 안에서 App Store가 보이면 안 된다(스토어 심사 2.3.10). PC는 둘 다 보인다. -->
    <script is:inline>
      (function () {
        var u = navigator.userAgent;
        var c = /Android/i.test(u)
          ? 'os-android'
          : /iPhone|iPad|iPod/.test(u) ||
              (/Macintosh/.test(u) && navigator.maxTouchPoints > 1)
            ? 'os-ios'
            : '';
        if (c) document.documentElement.classList.add(c);
      })();
    </script>
    <script is:inline src="/analytics.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {copy[lang].skip}
    </a>
    <slot />
  </body>
</html>
