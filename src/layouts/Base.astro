---
import '@fontsource-variable/outfit';
import '@fontsource-variable/noto-sans-kr';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'sunworks — 아이디어를 일상으로',
  description = 'sunworks는 AI 바이브 코딩으로 자체 앱과 웹서비스를 만드는 제품 회사입니다. 첫 제품 어흥!한자를 만나보세요.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef1fa" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="sunworks" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL('/social-card.png', Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="sunworks — 아이디어를 일상으로" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      본문으로 바로가기
    </a>
    <slot />
  </body>
</html>
